#!/bin/bash
# kustuta_kasutajad - abiskript testkasutajate kustutamiseks enne uut katsetust
# Autor: Rico Kandi
#
# Kasutamine: sudo ./kustuta_kasutajad failinimi
#
# Faili iga rida on kasutajanimi või kasutajanimi:parool.
# userdel -r kustutab kasutaja koos kodukataloogi ja postkastiga.

if [ $# -ne 1 ]; then
    echo "Kasutusjuhend: $0 failinimi"
    exit 1
fi

if [ ! -r "$1" ]; then
    echo "Probleem failiga $1"
    exit 2
fi

while IFS= read -r rida || [ -n "$rida" ]
do
    kasutajanimi=$(echo "$rida" | cut -d: -f1)
    if [ -z "$kasutajanimi" ]; then
        continue
    fi
    if id "$kasutajanimi" > /dev/null 2>&1; then
        userdel -r "$kasutajanimi" 2> /dev/null
        echo "Kasutaja $kasutajanimi on kustutatud"
    else
        echo "Kasutajat $kasutajanimi ei ole"
    fi
done < "$1"
